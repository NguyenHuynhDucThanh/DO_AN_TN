APP_ENV=development
DATABASE_URL=postgresql+psycopg://healthcare_app:CHANGE_ME@localhost:5432/healthcare_dev
FRONTEND_ORIGIN=http://localhost:5173

# Development has a safe-to-replace fallback. Production startup rejects that fallback.
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# May remain true only for controlled development/test use. Production requires false.
DEV_AUTH_ENABLED=true
COOKIE_SECURE=false

# Backend-only Gemini configuration. Never expose GEMINI_API_KEY to Vite/Frontend.
# Suggested low-cost text model as of 22/10/2026; verify availability with
# scripts/check_gemini.py after configuring a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=10
TOOL_CONFIRMATION_MINUTES=5
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=8
RAG_TOP_K=5
RAG_MAX_COSINE_DISTANCE=0.65
RAG_STRATEGY=hnsw_dense
RAG_DENSE_CANDIDATES=20
RAG_SPARSE_CANDIDATES=20
RAG_RRF_K=60
RAG_HNSW_EF_SEARCH=40
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANK_CANDIDATES=20
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
RAG_MAX_FILE_BYTES=2000000000

# Vietnamese push-to-talk STT. The model is downloaded by faster-whisper on first use.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_TIMEOUT_SECONDS=90
STT_MAX_FILE_BYTES=10000000

# Bounded in-process protection for the single Backend instance. For multi-instance
# deployment, also enforce shared rate limits at the hosting platform/reverse proxy.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=5
REFRESH_RATE_LIMIT=30
CHAT_RATE_LIMIT=30
VOICE_RATE_LIMIT=10
INGESTION_RATE_LIMIT=5
COMMON_RATE_WINDOW_SECONDS=60
